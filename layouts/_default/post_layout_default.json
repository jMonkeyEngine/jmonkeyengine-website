{{ if eq .RelPermalink "/donate/" }}
{{ $payload := .Site.Data.donate.funds | default dict }}
{{ $funds := $payload.funds | default (slice) }}
{{ if not $funds }}
    {{ $funds = slice (dict
        "id" "main"
        "slug" "jmonkeyengine"
        "name" "Main fund"
        "description" "Flexible support. The core team allocates funds where they are most needed."
        "url" "https://opencollective.com/jmonkeyengine"
        "primary" true
        "icon" "fa-solid fa-heart"
    ) }}
{{ end }}
{{ $fundsWithIcons := slice }}
{{ range $funds }}
    {{ $fundsWithIcons = $fundsWithIcons | append (merge . (dict "icon" (partial "donate-fund-icon.html" (dict "fund" . "site" $.Site)))) }}
{{ end }}
{{ $response := dict
    "apiVersion" "1.0"
    "response" "donationFunds"
    "title" .Title
    "url" (.Permalink | absURL)
    "generatedAt" $payload.generatedAt
    "source" $payload.source
    "summary" $payload.summary
    "funds" $fundsWithIcons
    "status" $payload.status
}}
{{ $response | jsonify }}
{{ else }}
{
    "responseTitle":"{{ block "title" . }}{{ .Site.Title }} {{ with .Params.Title }} | {{ . }}{{ end }}{{ end }}",
    "apiVersion":"1.0",
    "response":"defaultEntry",
    "uid":{{ .File.UniqueID | jsonify }},

    "title":{{.Title | jsonify}},
    "content":{{ .Content | jsonify}},
    "contentPlain":{{ .Content| plainify | jsonify}} ,
    "url":{{ .Permalink  | absURL | jsonify }},


    {{ if .Params.summary }}
    "summary":{{ .Params.summary | plainify  | jsonify }},
    {{else}}
    "summary":{{.Summary | plainify | jsonify }}   ,
    {{ end }}
    "tags":[
        {{ range $i, $e  :=  .Params.tags  }}
             {{ if $i }} , {{end}}
             "{{ $e }}"
        {{ end }}
        ],
        "authors":[
            {{ range $i, $e  :=  .Params.authors  }}
                 {{ if $i }} , {{end}}
                 "{{ $e }}"
            {{ end }}
            ]


}
{{ end }}
